# ============================================================================
# Plantilla de opciones de Suunto Stats
#
# Cómo usarla:
#   1. Copia este fichero con el nombre .env (en la carpeta del proyecto):
#        Windows (PowerShell):  Copy-Item .env.example .env
#        Mac / Linux:           cp .env.example .env
#   2. En .env, quita el # de las líneas que quieras usar y pon tus valores.
#
# .env está en .gitignore: NUNCA se sube a GitHub. No pongas claves en este fichero
# (.env.example), que sí se sube. Los valores de abajo son solo ejemplos.
#
# Nada es obligatorio: sin .env la app funciona con los datos de Suunto
# (la sesión la crea `suuntool login`, no hace falta email ni contraseña aquí).
# ============================================================================


# ---- Acceso ----------------------------------------------------------------

# none (por defecto): solo en este ordenador, sin login. Es lo normal si la usas en casa.
# authelia: en un dominio público, con contraseña y código. Guía: GUIA_DESPLIEGUE.md (in English: GUIDE_DEPLOY.md)
# Se lee al arrancar la app. Sin Authelia, cualquier acceso desde otro equipo o un dominio se rechaza.
# AUTH_MODE=none


# ---- Suunto ----------------------------------------------------------------

# Zona horaria de tus actividades (por defecto, la de tu ordenador)
# SUUNTO_TIMEZONE=Europe/Madrid

# Pausa en segundos entre actividades al descargar; súbela si ves errores 429
# SUUNTO_PAUSE=0.6

# Solo si no usas suuntool: tu clave de sesión de Suunto.
# Equivale a una contraseña: no la compartas.
# SUUNTO_SESSION_KEY=tu-clave-de-sesion-de-suunto

# Solo si el servidor rechazara el User-Agent por defecto
# SUUNTO_USER_AGENT=Mozilla/5.0

# Solo con ficheros FIT (py fetch\sync.py --source fit): tu FC máxima para calcular las zonas
# MAX_HR=185


# ---- TrainingPeaks (opcional: páginas Plan, Calendario y Competiciones) ----

# Cookie «Production_tpAuth» de app.trainingpeaks.com. Cómo sacarla: GUIA_TRAININGPEAKS.md (in English: GUIDE_TRAININGPEAKS.md)
# Equivale a una contraseña: no la compartas. Caduca cada cierto tiempo; si falla, vuelve a copiarla.
# La app solo LEE de TrainingPeaks; nunca escribe nada en tu cuenta.
# TP_AUTH_COOKIE=pega-aqui-el-valor-de-la-cookie

# Solo si no encuentra tu id de atleta automáticamente (un número)
# TP_ATHLETE_ID=1234567


# ---- Gemini (opcional: página Entrenador IA) -------------------------------

# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
# Equivale a una contraseña: no la compartas. Se queda en el servidor de la app; el navegador no la ve.
# GEMINI_API_KEY=tu-clave-de-google-ai-studio

# Modelo principal (por defecto gemini-3.8-flash). Si falla varias veces, la app prueba sola con
# gemini-3.5-flash-lite y luego con gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.8-flash


# ---- Otra IA en lugar de Gemini (opcional) ---------------------------------

# AI_PROVIDER elige la IA del Entrenador IA: gemini (por defecto), openai o anthropic.
# Las claves se quedan en el servidor de la app; el navegador no las ve. No las compartas.
#
# openai = cualquier servicio con el formato de OpenAI (/chat/completions): OpenAI, Mistral, Groq, DeepSeek,
# OpenRouter… o una IA en tu ordenador con Ollama / LM Studio (sin clave; tus datos no salen de tu equipo).
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1        # Mistral: https://api.mistral.ai/v1 · Ollama: http://localhost:11434/v1
# AI_API_KEY=tu-clave-del-servicio              # sin clave si AI_BASE_URL es localhost
# AI_MODEL=nombre-del-modelo                    # obligatorio: el nombre exacto que da el servicio
#
# anthropic = Claude (clave de https://console.anthropic.com). Modelo por defecto: claude-opus-5-5.
# AI_PROVIDER=anthropic
# AI_API_KEY=tu-clave-de-anthropic
# AI_MODEL=claude-opus-5-5
#
# Con openai o anthropic, modelos de reserva (separados por comas) si el principal falla varias veces:
# AI_FALLBACK_MODELS=modelo-mas-ligero
