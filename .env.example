# Ya NO hace falta email ni contraseña: la sesión la crea `suuntool login`.
# Todo lo de abajo es opcional (quita el # para activarlo).

# Zona horaria para la hora local de tus actividades (por defecto, la de tu ordenador)
# SUUNTO_TIMEZONE=Europe/Madrid

# Solo si no usas suuntool: pega aquí tu clave de sesión (equivale a una contraseña, no la compartas)
# SUUNTO_SESSION_KEY=

# Solo si el servidor rechazara el User-Agent por defecto
# SUUNTO_USER_AGENT=

# Pausa (segundos) entre actividades al descargar; súbela si ves errores 429
# SUUNTO_PAUSE=0.6

# Importación de ficheros FIT (--source fit): FC máxima para calcular las zonas
# MAX_HR=185

# TrainingPeaks (página Plan): cookie Production_tpAuth de app.trainingpeaks.com.
# Equivale a una contraseña: no la compartas. Cómo obtenerla: GUIA_TRAININGPEAKS.md
# TP_AUTH_COOKIE=
# Solo si no encuentra tu id de atleta automáticamente
# TP_ATHLETE_ID=

# Gemini (página Entrenador IA): clave gratis de Google AI Studio. Equivale a una contraseña: no la compartas.
# GEMINI_API_KEY=
# Modelo principal (por defecto gemini-3.8-flash). Si falla varias veces, la app prueba sola con
# gemini-3.5-flash-lite y luego gemini-3.1-flash-lite
# GEMINI_MODEL=
